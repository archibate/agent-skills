{
  "cleanupPeriodDays": 3650,
  "skillListingBudgetFraction": 0.05,
  "$comment": "CLAUDE_ENV_FILE content: `if [ -S /dev/stdin ]; then exec </dev/null; fi`",
  "env": {
    "CLAUDE_ENV_FILE": "/home/bate/.claude/stdin-guard.sh",
    "ANTHROPIC_BASE_URL": "",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_AUTH_TOKEN": "",
    "IS_DEMO": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true",
    "API_TIMEOUT_MS": "1200000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "1",
    "CLAUDE_CODE_BASH_SANDBOX_SHOW_INDICATOR": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_TOTAL_TOKENS_REMINDER": "off",
    "CLAUDE_CODE_TODO_REMINDER_MODE": "off",
    "CLAUDE_CODE_SILENT_TURN_REMINDER": "0",
    "CLAUDE_CODE_ACT_DONT_REDERIVE": "0",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_CODE_COZY_TEAPOT": "relaxed",
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "BASH_MAX_TIMEOUT_MS": "240000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_SYNC_SKILLS": "0",
    "CLAUDE_CODE_SEND_FEEDBACK": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_AUTOUPDATE": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "init": "user-invocable-only",
    "schedule": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "update-config": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "viewMode": "default",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "awaySummaryEnabled": true,
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "10m",
  "tui": "fullscreen",
  "totalTokensReminder": "off",
  "syncClaudeAiSkills": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false,
  "autoContinueAtUsageLimit": true,
  "idleCompaction": true
}
