{
  "cleanupPeriodDays": 3650,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "BASH_MAX_TIMEOUT_MS": "240000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "schedule": "user-invocable-only",
    "design": "user-invocable-only",
    "morning": "user-invocable-only",
    "import-memory": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "promptCacheTtl": "5m",
  "subagentPromptCacheTtl": "5m",
  "model": "opus",
  "effortLevel": "high",
  "awaySummaryEnabled": true,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
